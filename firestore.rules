rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapOwnerEmail() {
      return isSignedIn() && (
        (request.auth.token.email == 'optimatech.lb@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'alaa@onalaastore.com' && request.auth.token.email_verified == true)
      );
    }

    // Strict Super Admin + Full Stock check against users/{uid} (and admins/{uid} compatibility record)
    function hasUserSuperAdminFullStock(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'super_admin'
        && get(/databases/$(database)/documents/users/$(uid)).data.isActive != false
        && get(/databases/$(database)/documents/users/$(uid)).data.permissions is list
        && 'full_stock' in get(/databases/$(database)/documents/users/$(uid)).data.permissions;
    }

    function hasAdminSuperAdminFullStock(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid))
        && get(/databases/$(database)/documents/admins/$(uid)).data.role == 'super_admin'
        && get(/databases/$(database)/documents/admins/$(uid)).data.isActive != false
        && get(/databases/$(database)/documents/admins/$(uid)).data.permissions is list
        && 'full_stock' in get(/databases/$(database)/documents/admins/$(uid)).data.permissions;
    }

    function isSuperAdminWithFullStock() {
      return isSignedIn() && (
        hasUserSuperAdminFullStock(request.auth.uid) ||
        hasAdminSuperAdminFullStock(request.auth.uid)
      );
    }

    // Bootstrapped Admin & Staff RBAC checks
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminWithFullStock() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'product_manager', 'order_manager', 'inventory_manager'] &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false
        ) ||
        isBootstrapOwnerEmail()
      );
    }

    // 3. Validation Blueprints
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customer', 'items', 'subtotal', 'total', 'paymentMethod', 'status'])
        && data.keys().hasOnly([
          'id', 'orderDate', 'customer', 'items', 'subtotal', 'discount',
          'deliveryFee', 'total', 'currency', 'paymentMethod', 'paymentStatus',
          'status', 'trackingNumber', 'statusHistory', 'userId'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.customer is map
        && data.customer.fullName is string && data.customer.fullName.size() > 0 && data.customer.fullName.size() <= 160
        && data.customer.phone is string && data.customer.phone.size() > 0 && data.customer.phone.size() <= 40
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 1000000
        && (!('discount' in data) || (data.discount is number && data.discount >= 0 && data.discount <= data.subtotal))
        && (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 10000))
        && data.total is number && data.total >= 0 && data.total <= 1000000
        && (!('currency' in data) || data.currency in ['USD'])
        && data.paymentMethod in ['cod', 'whish_money', 'store_pickup', 'omt_western_union']
        && (!('paymentStatus' in data) || data.paymentStatus in ['pending', 'paid', 'pay_on_delivery'])
        && data.status in ['new', 'confirmed', 'preparing', 'ready_for_delivery', 'out_for_delivery', 'dispatched', 'delivered', 'cancelled', 'returned']
        && (!('orderDate' in data) || (data.orderDate is string && data.orderDate.size() <= 64))
        && (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() <= 64))
        && (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 30))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50;
    }

    function isValidSearchAnalytics(data) {
      return data.keys().hasAll(['id', 'term', 'normalizedTerm', 'timestamp', 'source', 'intentPattern'])
        && data.id is string && data.id.size() <= 128
        && data.term is string && data.term.size() > 0 && data.term.size() <= 200
        && data.normalizedTerm is string && data.normalizedTerm.size() > 0 && data.normalizedTerm.size() <= 200
        && data.source is string && data.source.size() <= 64
        && data.intentPattern is string && data.intentPattern.size() <= 64;
    }

    function isValidAdminProfile(data) {
      return data.keys().hasAll(['username', 'email', 'role', 'permissions'])
        && data.keys().hasOnly([
          'id', 'uid', 'username', 'name', 'email', 'role', 'permissions', 'isActive', 'createdAt', 'updatedAt'
        ])
        && (!('id' in data) || isValidId(data.id))
        && (!('uid' in data) || (data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128))
        && data.username is string && data.username.size() > 0 && data.username.size() <= 64
        && (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 128))
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 128
        && data.email.matches('^[a-zA-Z0-9.!#$%&\'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)+$')
        && data.role in ['super_admin', 'product_manager', 'order_manager', 'inventory_manager']
        && data.permissions is list
        && data.permissions.size() > 0 && data.permissions.size() <= 20
        && data.permissions.hasOnly([
          'full_stock',
          'full_admin',
          'manage_products',
          'manage_orders',
          'manage_inventory',
          'manage_categories',
          'manage_content',
          'manage_customers',
          'manage_settings',
          'view_analytics',
          'view_audit_logs'
        ])
        && (!('isActive' in data) || data.isActive is bool)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'email', 'role', 'permissions'])
        && data.keys().hasOnly([
          'id', 'uid', 'username', 'name', 'email', 'role', 'permissions', 'isActive', 'createdAt', 'updatedAt'
        ])
        && (!('id' in data) || isValidId(data.id))
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.username is string && data.username.size() > 0 && data.username.size() <= 64
        && (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 128))
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 128
        && data.email.matches('^[a-zA-Z0-9.!#$%&\'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)+$')
        && data.role in ['super_admin', 'product_manager', 'order_manager', 'inventory_manager', 'customer']
        && data.permissions is list
        && data.permissions.size() <= 20
        && data.permissions.hasOnly([
          'full_stock',
          'full_admin',
          'manage_products',
          'manage_orders',
          'manage_inventory',
          'manage_categories',
          'manage_content',
          'manage_customers',
          'manage_settings',
          'view_analytics',
          'view_audit_logs'
        ])
        && (!('isActive' in data) || data.isActive is bool)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['id', 'productId', 'sku', 'productName', 'stock'])
        && data.keys().hasOnly([
          'id', 'productId', 'sku', 'productName', 'brand', 'category',
          'stock', 'lowStockThreshold', 'warehouse', 'updatedByUid', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.productId)
        && data.sku is string && data.sku.size() > 0 && data.sku.size() <= 64
        && data.productName is string && data.productName.size() > 0 && data.productName.size() <= 255
        && (!('brand' in data) || (data.brand is string && data.brand.size() <= 64))
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && (!('lowStockThreshold' in data) || (data.lowStockThreshold is number && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 100000))
        && (!('warehouse' in data) || (data.warehouse is string && data.warehouse.size() <= 128))
        && (!('updatedByUid' in data) || (data.updatedByUid is string && data.updatedByUid.size() <= 128))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidNewsletterSubscriber(data) {
      return data.keys().hasAll(['id', 'email', 'subscribedAt', 'lang', 'source'])
        && data.keys().hasOnly(['id', 'email', 'subscribedAt', 'lang', 'source'])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 128
        && data.email.matches('^[a-zA-Z0-9.!#$%&\'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)+$')
        && data.subscribedAt is string && data.subscribedAt.size() > 0 && data.subscribedAt.size() <= 64
        && data.lang in ['en', 'ar']
        && data.source is string && data.source.size() > 0 && data.source.size() <= 64;
    }

    function isValidSocialPost(data) {
      return data.keys().hasAll(['id', 'productId', 'productName', 'productPrice', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.productId is string && data.productId.size() <= 128
        && data.productName is string && data.productName.size() <= 255
        && data.productPrice is number && data.productPrice >= 0
        && data.status in ['draft', 'published', 'scheduled']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidSocialAccount(data) {
      return data.keys().hasAll(['id', 'platform', 'displayName', 'isConnected'])
        && data.id is string && data.id.size() <= 128
        && data.platform in ['facebook', 'instagram', 'whatsapp', 'whatsapp_status', 'tiktok', 'telegram', 'x']
        && data.displayName is string && data.displayName.size() <= 128
        && data.isConnected is bool;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'brand', 'category', 'sku', 'price', 'stock', 'images', 'description', 'isPublished'])
        && data.keys().hasOnly([
          'id', 'name', 'nameAr', 'brand', 'category', 'subcategory', 'sku', 'barcode',
          'originalPrice', 'price', 'discountPercentage', 'stock', 'lowStockThreshold',
          'images', 'videoUrl', 'description', 'descriptionAr', 'specifications',
          'variants', 'colors', 'colorImages', 'warrantyMonths', 'warrantyTerms',
          'isSpecialOffer', 'offerExpiresAt', 'isFeatured', 'isNewArrival', 'isBestSeller',
          'isPublished', 'rating', 'reviewCount', 'soldCount', 'reviews', 'createdAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 255
        && (!('nameAr' in data) || (data.nameAr is string && data.nameAr.size() <= 255))
        && data.brand is string && data.brand.size() > 0 && data.brand.size() <= 64
        && data.category is string && data.category.size() > 0 && data.category.size() <= 64
        && (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 64))
        && data.sku is string && data.sku.size() > 0 && data.sku.size() <= 64
        && (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 64))
        && data.price is number && data.price >= 0 && data.price <= 1000000
        && (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 1000000))
        && (!('discountPercentage' in data) || (data.discountPercentage is number && data.discountPercentage >= 0 && data.discountPercentage <= 100))
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && (!('lowStockThreshold' in data) || (data.lowStockThreshold is number && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 100000))
        && data.images is list && data.images.size() > 0 && data.images.size() <= 30 && data.images[0] is string
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 512))
        && data.description is string && data.description.size() <= 5000
        && (!('descriptionAr' in data) || (data.descriptionAr is string && data.descriptionAr.size() <= 5000))
        && (!('specifications' in data) || (data.specifications is list && data.specifications.size() <= 60))
        && (!('variants' in data) || (data.variants is list && data.variants.size() <= 50))
        && (!('colors' in data) || (
          data.colors is list
          && data.colors.size() <= 30
          && (
            data.colors.size() == 0
            || data.colors[0] is string
            || (
              data.colors[0] is map
              && data.colors[0].keys().hasAll(['id', 'name', 'imageUrl'])
              && data.colors[0].keys().hasOnly(['id', 'name', 'hex', 'imageUrl', 'availableCapacities', 'priceAdjustment'])
              && data.colors[0].id is string && data.colors[0].id.size() > 0 && data.colors[0].id.size() <= 128
              && data.colors[0].name is string && data.colors[0].name.size() > 0 && data.colors[0].name.size() <= 80
              && data.colors[0].imageUrl is string && data.colors[0].imageUrl.size() <= 200000
              && (!('hex' in data.colors[0]) || (data.colors[0].hex is string && data.colors[0].hex.size() <= 20))
              && (!('availableCapacities' in data.colors[0]) || (data.colors[0].availableCapacities is list && data.colors[0].availableCapacities.size() <= 30))
              && (!('priceAdjustment' in data.colors[0]) || (data.colors[0].priceAdjustment is number && data.colors[0].priceAdjustment >= -100000 && data.colors[0].priceAdjustment <= 100000))
            )
          )
        ))
        && (!('colorImages' in data) || data.colorImages is map)
        && (!('warrantyMonths' in data) || (data.warrantyMonths is number && data.warrantyMonths >= 0 && data.warrantyMonths <= 120))
        && (!('warrantyTerms' in data) || (data.warrantyTerms is string && data.warrantyTerms.size() <= 2000))
        && (!('isSpecialOffer' in data) || data.isSpecialOffer is bool)
        && (!('offerExpiresAt' in data) || (data.offerExpiresAt is string && data.offerExpiresAt.size() <= 64))
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && (!('isNewArrival' in data) || data.isNewArrival is bool)
        && (!('isBestSeller' in data) || data.isBestSeller is bool)
        && data.isPublished is bool
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 100000))
        && (!('soldCount' in data) || (data.soldCount is number && data.soldCount >= 0 && data.soldCount <= 1000000))
        && (!('reviews' in data) || (data.reviews is list && data.reviews.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'nameAr', 'slug', 'iconName', 'displayOrder'])
        && data.keys().hasOnly(['id', 'name', 'nameAr', 'slug', 'iconName', 'image', 'description', 'featured', 'displayOrder', 'subcategories'])
        && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.nameAr is string && data.nameAr.size() > 0 && data.nameAr.size() <= 128
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 128
        && data.iconName is string && data.iconName.size() > 0 && data.iconName.size() <= 64
        && data.displayOrder is number && data.displayOrder >= 0 && data.displayOrder <= 10000
        && (!('image' in data) || (data.image is string && data.image.size() <= 1024))
        && (!('description' in data) || (data.description is string && data.description.size() <= 512))
        && (!('featured' in data) || data.featured is bool)
        && (!('subcategories' in data) || (
          data.subcategories is list
          && data.subcategories.size() <= 25
          && (data.subcategories.size() == 0 || data.subcategories[0] is string)
        ));
    }

    function isValidStockNotification(data) {
      return data.keys().hasAll(['id', 'productId', 'productName', 'productPrice', 'email', 'lang', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'productName', 'productNameAr', 'productBrand', 'productPrice', 'productImage', 'email', 'lang', 'status', 'createdAt', 'notifiedAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && data.productName is string && data.productName.size() > 0 && data.productName.size() <= 255
        && (!('productNameAr' in data) || (data.productNameAr is string && data.productNameAr.size() <= 255))
        && (!('productBrand' in data) || (data.productBrand is string && data.productBrand.size() <= 64))
        && data.productPrice is number && data.productPrice >= 0
        && (!('productImage' in data) || (data.productImage is string && data.productImage.size() <= 1024))
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 128
        && data.email.matches('^[a-zA-Z0-9.!#$%&\'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)+$')
        && data.lang in ['en', 'ar']
        && data.status in ['pending', 'notified']
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64
        && (!('notifiedAt' in data) || (data.notifiedAt is string && data.notifiedAt.size() <= 64));
    }

    function isValidAdminActivityLog(data) {
      return data.keys().hasAll(['id', 'action', 'titleEn', 'category', 'severity', 'actor', 'timestamp'])
        && data.keys().hasOnly(['id', 'action', 'titleEn', 'titleAr', 'category', 'severity', 'target', 'details', 'actor', 'source', 'timestamp'])
        && isValidId(data.id)
        && data.action is string && data.action.size() > 0 && data.action.size() <= 80
        && data.titleEn is string && data.titleEn.size() > 0 && data.titleEn.size() <= 200
        && (!('titleAr' in data) || (data.titleAr is string && data.titleAr.size() <= 200))
        && data.category in ['security', 'settings', 'catalog', 'orders', 'content']
        && data.severity in ['info', 'warning', 'critical']
        && (!('target' in data) || (data.target is string && data.target.size() <= 160))
        && (!('details' in data) || (data.details is string && data.details.size() <= 480))
        && data.actor is map
        && data.actor.name is string && data.actor.name.size() > 0 && data.actor.name.size() <= 100
        && data.actor.username is string && data.actor.username.size() > 0 && data.actor.username.size() <= 64
        && data.actor.role in ['super_admin', 'product_manager', 'order_manager', 'inventory_manager', 'system']
        && (!('email' in data.actor) || (data.actor.email is string && data.actor.email.size() <= 128))
        && (!('source' in data.actor) || data.actor.source in ['server', 'client', 'firestore'])
        && (!('source' in data) || data.source in ['server', 'client', 'firestore'])
        && data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64;
    }

    // 4. Connection Test Document for getDocFromServer
    match /test/connection {
      allow get: if true;
    }

    // 5. Orders Collection: Public order submission with Lebanese tracking, admin fulfillment
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        resource.data.id == orderId
      );

      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && (!('userId' in incoming()) || !isSignedIn() || incoming().userId == request.auth.uid);

      allow update: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && (
          isAdmin() ||
          (
            isSignedIn()
            && existing().userId == request.auth.uid
            && existing().status == 'new'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          )
        );

      allow delete: if isAdmin();
    }

    // 6. Search Analytics: Client query intent logging & admin dashboard reporting
    match /search_analytics/{eventId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(eventId)
        && isValidSearchAnalytics(incoming())
        && incoming().id == eventId;

      allow update, delete: if isAdmin();
    }

    // 7a. User Profiles Collection (users/{uid}): Strict self-service PII isolation + anti-privilege-escalation
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (
          isAdmin() ||
          (
            request.auth.uid == userId
            && incoming().uid == request.auth.uid
            && incoming().role == 'customer'
            && incoming().permissions.size() == 0
          )
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (!('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt)
        && (
          isAdmin() ||
          (
            request.auth.uid == userId
            && incoming().uid == existing().uid
            && incoming().role == existing().role
            && incoming().permissions == existing().permissions
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // 7b. Admin RBAC Collection
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(adminUid) && isValidAdminProfile(incoming());
      allow update: if isAdmin() && isValidId(adminUid) && isValidAdminProfile(incoming())
        && (!('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt);
      allow delete: if isAdmin() && isValidId(adminUid);
    }

    // 8a. Inventory Collection: Authenticated read; write/delete strictly restricted to Super Admin with Full Stock permission
    match /inventory/{inventoryId} {
      allow get: if isValidId(inventoryId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.stock >= 0;

      allow create: if isSignedIn()
        && isValidId(inventoryId)
        && isValidInventoryItem(incoming())
        && incoming().id == inventoryId
        && isSuperAdminWithFullStock();

      allow update: if isSignedIn()
        && isValidId(inventoryId)
        && isValidInventoryItem(incoming())
        && incoming().id == existing().id
        && incoming().productId == existing().productId
        && isSuperAdminWithFullStock();

      allow delete: if isSignedIn()
        && isValidId(inventoryId)
        && isSuperAdminWithFullStock();
    }

    // 8b. Products Collection: Public catalog read; stock/catalog writes/deletes strictly restricted to Super Admin with Full Stock
    match /products/{productId} {
      allow get, list: if true;

      allow create: if isSignedIn()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && isSuperAdminWithFullStock();

      allow update: if isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && (
          isSuperAdminWithFullStock() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['reviews', 'rating', 'reviewCount'])
        );

      allow delete: if isSignedIn()
        && isValidId(productId)
        && isSuperAdminWithFullStock();
    }

    // 8c. Categories Collection: Public storefront categories, admin-only management
    match /categories/{categoryId} {
      allow get, list: if true;

      allow create: if isAdmin()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == categoryId;

      allow update: if isAdmin()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == existing().id;

      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // 9. Newsletter Subscribers Collection: PII-isolated signup with strict field validation
    match /newsletter_subscribers/{subscriberId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(subscriberId)
        && isValidNewsletterSubscriber(incoming())
        && incoming().id == subscriberId;
      allow update: if isValidId(subscriberId)
        && isValidNewsletterSubscriber(incoming())
        && (
          isAdmin() ||
          (
            incoming().id == existing().id
            && incoming().email == existing().email
            && incoming().diff(existing()).affectedKeys().hasOnly(['subscribedAt', 'lang', 'source'])
          )
        );
      allow delete: if isAdmin() && isValidId(subscriberId);
    }

    // 10. Social Posts Collection: Admin marketing drafts and campaign log
    match /social_posts/{postId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(postId) && isValidSocialPost(incoming()) && incoming().id == postId;
      allow delete: if isAdmin() && isValidId(postId);
    }

    // 11. Social Accounts Configuration: Admin channel integration credentials
    match /social_accounts/{accountId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(accountId) && isValidSocialAccount(incoming()) && incoming().id == accountId;
      allow delete: if isAdmin() && isValidId(accountId);
    }

    // 12. Stock Notifications Collection: PII-isolated out-of-stock restock alerts
    match /stock_notifications/{notificationId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(notificationId)
        && isValidStockNotification(incoming())
        && incoming().id == notificationId
        && incoming().status == 'pending'
        && !('notifiedAt' in incoming());

      allow update: if isValidId(notificationId)
        && isValidStockNotification(incoming())
        && (
          isAdmin() ||
          (
            incoming().id == existing().id
            && incoming().productId == existing().productId
            && incoming().email == existing().email
            && incoming().status == 'pending'
            && !('notifiedAt' in incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['lang', 'createdAt', 'productPrice', 'productName', 'productNameAr', 'productBrand', 'productImage', 'status', 'notifiedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(notificationId);
    }

    // 13. Admin Activity Logs Collection: Immutable admin-only security & change audit log
    match /admin_activity_logs/{logId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(logId)
        && isValidAdminActivityLog(incoming())
        && incoming().id == logId;

      allow update, delete: if false;
    }
  }
}
