{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer purchase order for electronics, mobile devices, and accessories with Lebanon delivery tracking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique Order ID such as ARN-2027-1001",
          "maxLength": 64
        },
        "orderDate": {
          "type": "string",
          "description": "ISO timestamp of when the order was submitted"
        },
        "customer": {
          "type": "object",
          "description": "Customer contact and delivery details"
        },
        "items": {
          "type": "array",
          "description": "List of ordered products and quantities"
        },
        "subtotal": {
          "type": "number",
          "description": "Order items subtotal in USD"
        },
        "deliveryFee": {
          "type": "number",
          "description": "Delivery fee based on zone"
        },
        "total": {
          "type": "number",
          "description": "Grand total in USD"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cod", "whish_money", "omt_western_union"]
        },
        "status": {
          "type": "string",
          "enum": ["new", "confirmed", "preparing", "dispatched", "delivered", "cancelled", "returned"]
        },
        "trackingNumber": {
          "type": "string",
          "maxLength": 64
        },
        "statusHistory": {
          "type": "array",
          "description": "Timeline of status transitions"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID if submitted by logged-in user",
          "maxLength": 128
        }
      },
      "required": ["id", "customer", "items", "subtotal", "total", "paymentMethod", "status"]
    },
    "SearchAnalytics": {
      "title": "SearchAnalytics",
      "description": "Tracked search terms and user intent patterns for market demand analysis",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Search event identifier",
          "maxLength": 128
        },
        "term": {
          "type": "string",
          "description": "Raw searched term",
          "maxLength": 200
        },
        "normalizedTerm": {
          "type": "string",
          "description": "Normalized lowercase search term",
          "maxLength": 200
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of search event"
        },
        "source": {
          "type": "string",
          "description": "Source interaction type",
          "maxLength": 64
        },
        "intentPattern": {
          "type": "string",
          "description": "Classified shopping intent",
          "maxLength": 64
        },
        "categoryMatchesCount": {
          "type": "number",
          "description": "Number of matching categories"
        },
        "productMatchesCount": {
          "type": "number",
          "description": "Number of matching products"
        },
        "hasResults": {
          "type": "boolean",
          "description": "Whether query matched any store items"
        }
      },
      "required": ["id", "term", "normalizedTerm", "timestamp", "source", "intentPattern"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Authorized administrator or staff role record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "product_manager", "order_manager", "inventory_manager"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Store merchandise product with specifications, pricing, stock, high-res images, and multi-language descriptions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product SKU or identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "English product title",
          "maxLength": 255
        },
        "nameAr": {
          "type": "string",
          "description": "Arabic product title",
          "maxLength": 255
        },
        "brand": {
          "type": "string",
          "description": "Manufacturer or brand name",
          "maxLength": 64
        },
        "category": {
          "type": "string",
          "description": "Department or category name",
          "maxLength": 64
        },
        "subcategory": {
          "type": "string",
          "description": "Optional subcategory name",
          "maxLength": 64
        },
        "sku": {
          "type": "string",
          "description": "Stock Keeping Unit code",
          "maxLength": 64
        },
        "barcode": {
          "type": "string",
          "description": "Barcode or serial identifier",
          "maxLength": 64
        },
        "originalPrice": {
          "type": "number",
          "description": "Original retail price in USD"
        },
        "price": {
          "type": "number",
          "description": "Active selling price in USD"
        },
        "discountPercentage": {
          "type": "number",
          "description": "Calculated discount percentage"
        },
        "stock": {
          "type": "number",
          "description": "Available inventory units in Saida store"
        },
        "lowStockThreshold": {
          "type": "number",
          "description": "Threshold for low stock warnings"
        },
        "images": {
          "type": "array",
          "description": "List of high-resolution product image URLs"
        },
        "videoUrl": {
          "type": "string",
          "description": "Optional demonstration video link",
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "description": "English rich product overview",
          "maxLength": 5000
        },
        "descriptionAr": {
          "type": "string",
          "description": "Arabic rich product overview",
          "maxLength": 5000
        },
        "specifications": {
          "type": "array",
          "description": "Technical specifications"
        },
        "colors": {
          "type": "array",
          "description": "Available color variants"
        },
        "rating": {
          "type": "number",
          "description": "Customer average rating score (1-5)"
        },
        "reviewCount": {
          "type": "number",
          "description": "Number of customer reviews"
        },
        "isSpecialOffer": {
          "type": "boolean",
          "description": "Whether product is in special offers spotlight"
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether product is in featured spotlight"
        },
        "isNewArrival": {
          "type": "boolean",
          "description": "Whether product is marked as newest arrival"
        },
        "isBestSeller": {
          "type": "boolean",
          "description": "Whether product is marked as a top bestseller"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether product is visible on public storefront"
        },
        "warrantyMonths": {
          "type": "number",
          "description": "Official Lebanese warranty period in months"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        }
      },
      "required": ["id", "name", "brand", "category", "sku", "price", "stock", "images", "description", "isPublished"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Customer email subscription for tech updates and promotional marketing",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Sanitized subscriber ID based on email",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Subscriber email address",
          "minLength": 3,
          "maxLength": 128
        },
        "subscribedAt": {
          "type": "string",
          "description": "ISO timestamp of subscription",
          "maxLength": 64
        },
        "lang": {
          "type": "string",
          "description": "User language preference (en or ar)",
          "enum": ["en", "ar"]
        },
        "source": {
          "type": "string",
          "description": "Acquisition source (footer, checkout, services)",
          "maxLength": 64
        }
      },
      "required": ["id", "email", "subscribedAt", "lang", "source"]
    },
    "SocialMarketingPost": {
      "title": "SocialMarketingPost",
      "description": "Product marketing campaign post for social media channels including captions, hashtags, and generated graphics",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique post ID",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "description": "Referenced product SKU or identifier",
          "maxLength": 128
        },
        "productName": {
          "type": "string",
          "description": "Product title in post",
          "maxLength": 255
        },
        "productBrand": {
          "type": "string",
          "maxLength": 64
        },
        "productCategory": {
          "type": "string",
          "maxLength": 64
        },
        "productPrice": {
          "type": "number",
          "description": "Cash price in USD"
        },
        "originalPrice": {
          "type": "number"
        },
        "discountPercentage": {
          "type": "number"
        },
        "productImage": {
          "type": "string",
          "maxLength": 1024
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["1:1", "9:16", "16:9"]
        },
        "templateStyle": {
          "type": "string",
          "enum": ["modern_dark", "minimal_white", "hot_deal", "coloros_purple"]
        },
        "captionEn": {
          "type": "string",
          "maxLength": 5000
        },
        "captionAr": {
          "type": "string",
          "maxLength": 5000
        },
        "hashtags": {
          "type": "array"
        },
        "selectedPlatforms": {
          "type": "array"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "scheduled"]
        },
        "createdAt": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string"
        }
      },
      "required": ["id", "productId", "productName", "productPrice", "status", "createdAt"]
    },
    "SocialAccountConfig": {
      "title": "SocialAccountConfig",
      "description": "Social media channel connection status and publishing settings for store administration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "platform": {
          "type": "string",
          "enum": ["facebook", "instagram", "whatsapp", "whatsapp_status", "tiktok", "telegram", "x"]
        },
        "displayName": {
          "type": "string",
          "maxLength": 128
        },
        "accountHandle": {
          "type": "string",
          "maxLength": 128
        },
        "isConnected": {
          "type": "boolean"
        },
        "directPublishSupported": {
          "type": "boolean"
        },
        "directPublishEnabled": {
          "type": "boolean"
        },
        "channelId": {
          "type": "string",
          "maxLength": 128
        },
        "lastSyncedAt": {
          "type": "string"
        }
      },
      "required": ["id", "platform", "displayName", "isConnected"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": {
        "$ref": "Order"
      },
      "description": "Customer purchase orders and status tracking"
    },
    "/search_analytics/{eventId}": {
      "schema": {
        "$ref": "SearchAnalytics"
      },
      "description": "Aggregated popular search terms and buyer intent patterns"
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "AdminProfile"
      },
      "description": "RBAC admin access control mapping"
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "Product"
      },
      "description": "Store electronics inventory catalog documents synced live across clients"
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": {
        "$ref": "NewsletterSubscriber"
      },
      "description": "Customer emails captured for marketing updates and tech deals"
    },
    "/social_posts/{postId}": {
      "schema": {
        "$ref": "SocialMarketingPost"
      },
      "description": "Saved social marketing campaign drafts and publishing log"
    },
    "/social_accounts/{accountId}": {
      "schema": {
        "$ref": "SocialAccountConfig"
      },
      "description": "Connected social media channels configuration and account handles"
    }
  }
}

