{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer purchase order for electronics, mobile devices, and accessories with Lebanon delivery tracking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique Order ID such as ARN-2027-1001",
          "maxLength": 64
        },
        "orderDate": {
          "type": "string",
          "description": "ISO timestamp of when the order was submitted"
        },
        "customer": {
          "type": "object",
          "description": "Customer contact and delivery details"
        },
        "items": {
          "type": "array",
          "description": "List of ordered products and quantities"
        },
        "subtotal": {
          "type": "number",
          "description": "Order items subtotal in USD"
        },
        "discount": {
          "type": "number",
          "description": "Promo code discount applied in USD"
        },
        "deliveryFee": {
          "type": "number",
          "description": "Delivery fee based on zone"
        },
        "total": {
          "type": "number",
          "description": "Grand total in USD"
        },
        "currency": {
          "type": "string",
          "enum": ["USD"]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cod", "whish_money", "store_pickup", "omt_western_union"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "paid", "pay_on_delivery"]
        },
        "status": {
          "type": "string",
          "enum": ["new", "confirmed", "preparing", "ready_for_delivery", "out_for_delivery", "dispatched", "delivered", "cancelled", "returned"]
        },
        "trackingNumber": {
          "type": "string",
          "maxLength": 64
        },
        "statusHistory": {
          "type": "array",
          "description": "Timeline of status transitions"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID if submitted by logged-in user",
          "maxLength": 128
        }
      },
      "required": ["id", "customer", "items", "subtotal", "total", "paymentMethod", "status"]
    },
    "SearchAnalytics": {
      "title": "SearchAnalytics",
      "description": "Tracked search terms and user intent patterns for market demand analysis",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Search event identifier",
          "maxLength": 128
        },
        "term": {
          "type": "string",
          "description": "Raw searched term",
          "maxLength": 200
        },
        "normalizedTerm": {
          "type": "string",
          "description": "Normalized lowercase search term",
          "maxLength": 200
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of search event"
        },
        "source": {
          "type": "string",
          "description": "Source interaction type",
          "maxLength": 64
        },
        "intentPattern": {
          "type": "string",
          "description": "Classified shopping intent",
          "maxLength": 64
        },
        "categoryMatchesCount": {
          "type": "number",
          "description": "Number of matching categories"
        },
        "productMatchesCount": {
          "type": "number",
          "description": "Number of matching products"
        },
        "hasResults": {
          "type": "boolean",
          "description": "Whether query matched any store items"
        }
      },
      "required": ["id", "term", "normalizedTerm", "timestamp", "source", "intentPattern"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Authorized administrator or staff role record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "product_manager", "order_manager", "inventory_manager"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Store merchandise product with specifications, pricing, stock, high-res images, and multi-language descriptions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product SKU or identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "English product title",
          "maxLength": 255
        },
        "nameAr": {
          "type": "string",
          "description": "Arabic product title",
          "maxLength": 255
        },
        "brand": {
          "type": "string",
          "description": "Manufacturer or brand name",
          "maxLength": 64
        },
        "category": {
          "type": "string",
          "description": "Department or category name",
          "maxLength": 64
        },
        "subcategory": {
          "type": "string",
          "description": "Optional subcategory name",
          "maxLength": 64
        },
        "sku": {
          "type": "string",
          "description": "Stock Keeping Unit code",
          "maxLength": 64
        },
        "barcode": {
          "type": "string",
          "description": "Barcode or serial identifier",
          "maxLength": 64
        },
        "originalPrice": {
          "type": "number",
          "description": "Original retail price in USD"
        },
        "price": {
          "type": "number",
          "description": "Active selling price in USD"
        },
        "discountPercentage": {
          "type": "number",
          "description": "Calculated discount percentage"
        },
        "stock": {
          "type": "number",
          "description": "Available inventory units in Saida store"
        },
        "lowStockThreshold": {
          "type": "number",
          "description": "Threshold for low stock warnings"
        },
        "images": {
          "type": "array",
          "description": "List of high-resolution product image URLs"
        },
        "videoUrl": {
          "type": "string",
          "description": "Optional demonstration video link",
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "description": "English rich product overview",
          "maxLength": 5000
        },
        "descriptionAr": {
          "type": "string",
          "description": "Arabic rich product overview",
          "maxLength": 5000
        },
        "specifications": {
          "type": "array",
          "description": "Technical specifications"
        },
        "colors": {
          "type": "array",
          "description": "Available color variants"
        },
        "colorImages": {
          "type": "object",
          "description": "Per-color dedicated product image URLs keyed by color label"
        },
        "variants": {
          "type": "array",
          "description": "Optional variant configurations with per-variant pricing, SKU, stock, color, and image"
        },
        "rating": {
          "type": "number",
          "description": "Customer average rating score (1-5)"
        },
        "reviewCount": {
          "type": "number",
          "description": "Number of customer reviews"
        },
        "soldCount": {
          "type": "number",
          "description": "Total units sold"
        },
        "reviews": {
          "type": "array",
          "description": "Customer product reviews (capped at 50 entries)"
        },
        "isSpecialOffer": {
          "type": "boolean",
          "description": "Whether product is in special offers spotlight"
        },
        "offerExpiresAt": {
          "type": "string",
          "description": "ISO expiration timestamp for special offer",
          "maxLength": 64
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether product is in featured spotlight"
        },
        "isNewArrival": {
          "type": "boolean",
          "description": "Whether product is marked as newest arrival"
        },
        "isBestSeller": {
          "type": "boolean",
          "description": "Whether product is marked as a top bestseller"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether product is visible on public storefront"
        },
        "warrantyMonths": {
          "type": "number",
          "description": "Official Lebanese warranty period in months"
        },
        "warrantyTerms": {
          "type": "string",
          "description": "Warranty terms and conditions summary",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        }
      },
      "required": ["id", "name", "brand", "category", "sku", "price", "stock", "images", "description", "isPublished"]
    },
    "Category": {
      "title": "Category",
      "description": "Dynamic storefront product department/category with bilingual titles, slug, display order, theme image, and subcategories",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique category identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "English category name",
          "minLength": 1,
          "maxLength": 128
        },
        "nameAr": {
          "type": "string",
          "description": "Arabic category name",
          "minLength": 1,
          "maxLength": 128
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly category slug",
          "minLength": 1,
          "maxLength": 128
        },
        "iconName": {
          "type": "string",
          "description": "Lucide icon identifier",
          "minLength": 1,
          "maxLength": 64
        },
        "image": {
          "type": "string",
          "description": "Optional custom banner image URL",
          "maxLength": 1024
        },
        "description": {
          "type": "string",
          "description": "Optional category subtitle or description",
          "maxLength": 512
        },
        "featured": {
          "type": "boolean",
          "description": "Whether category is highlighted in featured home showcase"
        },
        "displayOrder": {
          "type": "number",
          "description": "Sort order index in storefront grids"
        },
        "subcategories": {
          "type": "array",
          "description": "List of subcategory labels"
        }
      },
      "required": ["id", "name", "nameAr", "slug", "iconName", "displayOrder"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Customer email subscription for tech updates and promotional marketing",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Sanitized subscriber ID based on email",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Subscriber email address",
          "minLength": 3,
          "maxLength": 128
        },
        "subscribedAt": {
          "type": "string",
          "description": "ISO timestamp of subscription",
          "maxLength": 64
        },
        "lang": {
          "type": "string",
          "description": "User language preference (en or ar)",
          "enum": ["en", "ar"]
        },
        "source": {
          "type": "string",
          "description": "Acquisition source (footer, checkout, services)",
          "maxLength": 64
        }
      },
      "required": ["id", "email", "subscribedAt", "lang", "source"]
    },
    "SocialMarketingPost": {
      "title": "SocialMarketingPost",
      "description": "Product marketing campaign post for social media channels including captions, hashtags, and generated graphics",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique post ID",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "description": "Referenced product SKU or identifier",
          "maxLength": 128
        },
        "productName": {
          "type": "string",
          "description": "Product title in post",
          "maxLength": 255
        },
        "productBrand": {
          "type": "string",
          "maxLength": 64
        },
        "productCategory": {
          "type": "string",
          "maxLength": 64
        },
        "productPrice": {
          "type": "number",
          "description": "Cash price in USD"
        },
        "originalPrice": {
          "type": "number"
        },
        "discountPercentage": {
          "type": "number"
        },
        "productImage": {
          "type": "string",
          "maxLength": 1024
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["1:1", "9:16", "16:9"]
        },
        "templateStyle": {
          "type": "string",
          "enum": ["modern_dark", "minimal_white", "hot_deal", "coloros_purple"]
        },
        "captionEn": {
          "type": "string",
          "maxLength": 5000
        },
        "captionAr": {
          "type": "string",
          "maxLength": 5000
        },
        "hashtags": {
          "type": "array"
        },
        "selectedPlatforms": {
          "type": "array"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "scheduled"]
        },
        "createdAt": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string"
        }
      },
      "required": ["id", "productId", "productName", "productPrice", "status", "createdAt"]
    },
    "SocialAccountConfig": {
      "title": "SocialAccountConfig",
      "description": "Social media channel connection status and publishing settings for store administration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "platform": {
          "type": "string",
          "enum": ["facebook", "instagram", "whatsapp", "whatsapp_status", "tiktok", "telegram", "x"]
        },
        "displayName": {
          "type": "string",
          "maxLength": 128
        },
        "accountHandle": {
          "type": "string",
          "maxLength": 128
        },
        "isConnected": {
          "type": "boolean"
        },
        "directPublishSupported": {
          "type": "boolean"
        },
        "directPublishEnabled": {
          "type": "boolean"
        },
        "channelId": {
          "type": "string",
          "maxLength": 128
        },
        "lastSyncedAt": {
          "type": "string"
        }
      },
      "required": ["id", "platform", "displayName", "isConnected"]
    },
    "StockNotification": {
      "title": "StockNotification",
      "description": "Customer email subscription requesting an automated restock alert when an out-of-stock product becomes available again",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Sanitized deterministic notification ID combining productId and email",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "description": "Referenced out-of-stock product identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "description": "English product name at subscription time",
          "maxLength": 255
        },
        "productNameAr": {
          "type": "string",
          "description": "Arabic product name at subscription time",
          "maxLength": 255
        },
        "productBrand": {
          "type": "string",
          "description": "Brand name",
          "maxLength": 64
        },
        "productPrice": {
          "type": "number",
          "description": "Product unit price in USD"
        },
        "productImage": {
          "type": "string",
          "description": "Primary product image URL",
          "maxLength": 1024
        },
        "email": {
          "type": "string",
          "description": "Subscriber email address for automated restock alert",
          "minLength": 3,
          "maxLength": 128
        },
        "lang": {
          "type": "string",
          "description": "Preferred notification language (en or ar)",
          "enum": ["en", "ar"]
        },
        "status": {
          "type": "string",
          "description": "Notification dispatch lifecycle status",
          "enum": ["pending", "notified"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when restock alert was requested",
          "maxLength": 64
        },
        "notifiedAt": {
          "type": "string",
          "description": "ISO timestamp when automated restock update was dispatched",
          "maxLength": 64
        }
      },
      "required": ["id", "productId", "productName", "productPrice", "email", "lang", "status", "createdAt"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "Immutable security and operational audit trail for sensitive administrator actions including password changes, settings updates, and catalog mutations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique sanitized audit event identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "description": "Normalized action code such as password_changed or settings_updated",
          "minLength": 1,
          "maxLength": 80
        },
        "titleEn": {
          "type": "string",
          "description": "Human-readable English summary of audited event",
          "minLength": 1,
          "maxLength": 200
        },
        "titleAr": {
          "type": "string",
          "description": "Human-readable Arabic summary of audited event",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Audit domain category",
          "enum": ["security", "settings", "catalog", "orders", "content"]
        },
        "severity": {
          "type": "string",
          "description": "Security impact severity level",
          "enum": ["info", "warning", "critical"]
        },
        "target": {
          "type": "string",
          "description": "Affected resource identifier or name",
          "maxLength": 160
        },
        "details": {
          "type": "string",
          "description": "Redacted context details of the sensitive change",
          "maxLength": 480
        },
        "actor": {
          "type": "object",
          "description": "Administrator user identity metadata"
        },
        "source": {
          "type": "string",
          "description": "Event origin channel",
          "enum": ["server", "client", "firestore"]
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 audit timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "action", "titleEn", "category", "severity", "actor", "timestamp"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": {
        "$ref": "Order"
      },
      "description": "Customer purchase orders and status tracking"
    },
    "/search_analytics/{eventId}": {
      "schema": {
        "$ref": "SearchAnalytics"
      },
      "description": "Aggregated popular search terms and buyer intent patterns"
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "AdminProfile"
      },
      "description": "RBAC admin access control mapping"
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "Product"
      },
      "description": "Store electronics inventory catalog documents synced live across clients"
    },
    "/categories/{categoryId}": {
      "schema": {
        "$ref": "Category"
      },
      "description": "Dynamic product departments and categories rendered on HomePage and Shop filters"
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": {
        "$ref": "NewsletterSubscriber"
      },
      "description": "Customer emails captured for marketing updates and tech deals"
    },
    "/social_posts/{postId}": {
      "schema": {
        "$ref": "SocialMarketingPost"
      },
      "description": "Saved social marketing campaign drafts and publishing log"
    },
    "/social_accounts/{accountId}": {
      "schema": {
        "$ref": "SocialAccountConfig"
      },
      "description": "Connected social media channels configuration and account handles"
    },
    "/stock_notifications/{notificationId}": {
      "schema": {
        "$ref": "StockNotification"
      },
      "description": "Out-of-stock product restock email subscriptions and automated dispatch status"
    },
    "/admin_activity_logs/{logId}": {
      "schema": {
        "$ref": "AdminActivityLog"
      },
      "description": "Immutable admin security and sensitive change audit trail restricted to verified administrators"
    }
  }
}

