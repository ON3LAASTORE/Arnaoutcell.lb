{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer purchase order for electronics, mobile devices, and accessories with Lebanon delivery tracking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique Order ID such as ARN-2027-1001",
          "maxLength": 64
        },
        "orderDate": {
          "type": "string",
          "description": "ISO timestamp of when the order was submitted"
        },
        "customer": {
          "type": "object",
          "description": "Customer contact and delivery details"
        },
        "items": {
          "type": "array",
          "description": "List of ordered products and quantities"
        },
        "subtotal": {
          "type": "number",
          "description": "Order items subtotal in USD"
        },
        "deliveryFee": {
          "type": "number",
          "description": "Delivery fee based on zone"
        },
        "total": {
          "type": "number",
          "description": "Grand total in USD"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cod", "whish_money", "omt_western_union"]
        },
        "status": {
          "type": "string",
          "enum": ["new", "confirmed", "preparing", "dispatched", "delivered", "cancelled", "returned"]
        },
        "trackingNumber": {
          "type": "string",
          "maxLength": 64
        },
        "statusHistory": {
          "type": "array",
          "description": "Timeline of status transitions"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID if submitted by logged-in user",
          "maxLength": 128
        }
      },
      "required": ["id", "customer", "items", "subtotal", "total", "paymentMethod", "status"]
    },
    "SearchAnalytics": {
      "title": "SearchAnalytics",
      "description": "Tracked search terms and user intent patterns for market demand analysis",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Search event identifier",
          "maxLength": 128
        },
        "term": {
          "type": "string",
          "description": "Raw searched term",
          "maxLength": 200
        },
        "normalizedTerm": {
          "type": "string",
          "description": "Normalized lowercase search term",
          "maxLength": 200
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of search event"
        },
        "source": {
          "type": "string",
          "description": "Source interaction type",
          "maxLength": 64
        },
        "intentPattern": {
          "type": "string",
          "description": "Classified shopping intent",
          "maxLength": 64
        },
        "categoryMatchesCount": {
          "type": "number",
          "description": "Number of matching categories"
        },
        "productMatchesCount": {
          "type": "number",
          "description": "Number of matching products"
        },
        "hasResults": {
          "type": "boolean",
          "description": "Whether query matched any store items"
        }
      },
      "required": ["id", "term", "normalizedTerm", "timestamp", "source", "intentPattern"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Authorized administrator or staff role record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "product_manager", "order_manager", "inventory_manager"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Store merchandise product with specifications, pricing, stock, high-res images, and multi-language descriptions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product SKU or identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "English product title",
          "maxLength": 255
        },
        "nameAr": {
          "type": "string",
          "description": "Arabic product title",
          "maxLength": 255
        },
        "brand": {
          "type": "string",
          "description": "Manufacturer or brand name",
          "maxLength": 64
        },
        "category": {
          "type": "string",
          "description": "Department or category name",
          "maxLength": 64
        },
        "subcategory": {
          "type": "string",
          "description": "Optional subcategory name",
          "maxLength": 64
        },
        "sku": {
          "type": "string",
          "description": "Stock Keeping Unit code",
          "maxLength": 64
        },
        "barcode": {
          "type": "string",
          "description": "Barcode or serial identifier",
          "maxLength": 64
        },
        "originalPrice": {
          "type": "number",
          "description": "Original retail price in USD"
        },
        "price": {
          "type": "number",
          "description": "Active selling price in USD"
        },
        "discountPercentage": {
          "type": "number",
          "description": "Calculated discount percentage"
        },
        "stock": {
          "type": "number",
          "description": "Available inventory units in Saida store"
        },
        "lowStockThreshold": {
          "type": "number",
          "description": "Threshold for low stock warnings"
        },
        "images": {
          "type": "array",
          "description": "List of high-resolution product image URLs"
        },
        "videoUrl": {
          "type": "string",
          "description": "Optional demonstration video link",
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "description": "English rich product overview",
          "maxLength": 5000
        },
        "descriptionAr": {
          "type": "string",
          "description": "Arabic rich product overview",
          "maxLength": 5000
        },
        "specifications": {
          "type": "array",
          "description": "Technical specifications"
        },
        "colors": {
          "type": "array",
          "description": "Available color variants"
        },
        "rating": {
          "type": "number",
          "description": "Customer average rating score (1-5)"
        },
        "reviewCount": {
          "type": "number",
          "description": "Number of customer reviews"
        },
        "isSpecialOffer": {
          "type": "boolean",
          "description": "Whether product is in special offers spotlight"
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether product is in featured spotlight"
        },
        "isNewArrival": {
          "type": "boolean",
          "description": "Whether product is marked as newest arrival"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether product is visible on public storefront"
        },
        "warrantyMonths": {
          "type": "number",
          "description": "Official Lebanese warranty period in months"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        }
      },
      "required": ["id", "name", "brand", "category", "sku", "price", "stock", "images", "description", "isPublished"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": {
        "$ref": "Order"
      },
      "description": "Customer purchase orders and status tracking"
    },
    "/search_analytics/{eventId}": {
      "schema": {
        "$ref": "SearchAnalytics"
      },
      "description": "Aggregated popular search terms and buyer intent patterns"
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "AdminProfile"
      },
      "description": "RBAC admin access control mapping"
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "Product"
      },
      "description": "Store electronics inventory catalog documents synced live across clients"
    }
  }
}
